{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "fitness-tracker"
		},
		"LS_SF_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SF'"
		},
		"LS_SQL__password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_'"
		},
		"LS_AKV_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://snowflakes-keyvault.vault.azure.net/"
		},
		"LS_BLS_sasUri": {
			"type": "secureString",
			"metadata": "Secure string for 'sasUri' of 'LS_BLS'"
		},
		"LS_SF_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "FITNESS_TRACKER"
		},
		"LS_SF_properties_typeProperties_role": {
			"type": "string",
			"defaultValue": "ACCOUNTADMIN"
		},
		"LS_SF_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "UQSPSIL-ANB46390.snowflakecomputing.com"
		},
		"LS_SQL__properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"LS_SQL__properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "fitness_tracker"
		},
		"LS_SQL__properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "AzureAD\\PoojaDharshiniBoopat"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "fitness-tracker_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_SF_password": {
						"value": "[parameters('LS_SF_password')]"
					},
					"LS_SQL__password": {
						"value": "[parameters('LS_SQL__password')]"
					},
					"LS_AKV_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_AKV_properties_typeProperties_baseUrl')]"
					},
					"LS_BLS_sasUri": {
						"value": "[parameters('LS_BLS_sasUri')]"
					},
					"LS_SF_properties_typeProperties_database": {
						"value": "[parameters('LS_SF_properties_typeProperties_database')]"
					},
					"LS_SF_properties_typeProperties_role": {
						"value": "[parameters('LS_SF_properties_typeProperties_role')]"
					},
					"LS_SF_properties_typeProperties_host": {
						"value": "[parameters('LS_SF_properties_typeProperties_host')]"
					},
					"LS_SQL__properties_typeProperties_server": {
						"value": "[parameters('LS_SQL__properties_typeProperties_server')]"
					},
					"LS_SQL__properties_typeProperties_database": {
						"value": "[parameters('LS_SQL__properties_typeProperties_database')]"
					},
					"LS_SQL__properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL__properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}